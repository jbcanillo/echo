# Backend configuration
PORT=8000
HOST=0.0.0.0
# Comma-separated allowed origins for CORS (leave empty to allow all in development)
CORS_ORIGIN=
# OpenRouter API key for text enhancement (optional)
OPENROUTER_API_KEY=
# OpenRouter model used for text enhancement
OPENROUTER_MODEL=openai/gpt-4o-mini
# TTS model to use for voice cloning
TTS_MODEL_NAME=tts_models/multilingual/multi-dataset/your_tts
# Limits
MAX_UPLOAD_MB=20
MAX_TEXT_LENGTH=1000
JOB_TIMEOUT_SECONDS=600
RATE_LIMIT_PER_MINUTE=5
