# Echo configuration: the single source of settings for Docker Compose, the backend and the frontend.
# Copy to .env (`cp .env.example .env`). Every value is optional; the defaults shown are used if a line is omitted.

# --- Backend ---
PORT=8000
HOST=0.0.0.0
# Comma-separated allowed origins for CORS (leave empty to allow all in development)
CORS_ORIGIN=
# OpenRouter API key for text enhancement (optional)
OPENROUTER_API_KEY=
# OpenRouter model used for text enhancement
OPENROUTER_MODEL=openai/gpt-4o-mini
# Voice model. You can also pick it in the app (Settings > Voice model); a choice made there wins over this line.
# The language list and the tuning sliders in the app follow it.
#   YourTTS (default): English, French and Brazilian Portuguese. About 425 MB. CC BY-NC-ND 4.0 (non-commercial)
#   XTTS-v2: tts_models/multilingual/multi-dataset/xtts_v2. 17 languages, a much larger download and slower on CPU.
#            Coqui Public Model License (non-commercial)
TTS_MODEL_NAME=tts_models/multilingual/multi-dataset/your_tts
# XTTS-v2 only: read https://coqui.ai/cpml and, if you accept it, uncomment the next line (or tick the box in Settings).
# Echo cannot accept it for you.
# COQUI_TOS_AGREED=1
# XTTS-v2 with Docker only: also install the packages for Japanese, Korean and Chinese (then rebuild the image)
# XTTS_LANGUAGES=true
# Limits
MAX_UPLOAD_MB=20
MAX_TEXT_LENGTH=5000
JOB_TIMEOUT_SECONDS=600
RATE_LIMIT_PER_MINUTE=5

# --- Frontend (VITE_* variables only; used by `npm run dev` and local builds, not by the Docker image) ---
# Leave empty to send /api requests through the dev server / nginx proxy.
# Set to e.g. http://localhost:8000 to call the backend directly (CORS must allow it).
VITE_BACKEND_URL=
# Where the Vite dev server proxies /api requests (defaults to http://localhost:$PORT)
VITE_PROXY_TARGET=
